{
  "type": "object",
  "required": [
    "id",
    "semantic_key",
    "owner_issue",
    "title",
    "basis",
    "conditions",
    "exceptions",
    "dependencies",
    "rule",
    "classification",
    "cpg_consequence",
    "platform_policy",
    "applicability",
    "proposed_checks",
    "evidence",
    "questions",
    "states",
    "status_owners"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^CPG-CPP03-REQ-[0-9]{6}$"
    },
    "semantic_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "owner_issue": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "type": "object",
      "required": [
        "kind",
        "source_id",
        "locators",
        "confidence",
        "review_note"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "iso2003",
            "draft",
            "dr",
            "policy"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "original_reviewed",
            "draft_only",
            "unresolved",
            "policy",
            "dr_reviewed"
          ]
        },
        "review_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "well_formed",
          "diagnostic_required",
          "ifndr",
          "undefined",
          "unspecified",
          "implementation_defined",
          "policy"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "cpg_consequence": {
      "type": "string",
      "minLength": 1
    },
    "platform_policy": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "required": [
        "status",
        "justification"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "proposed_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "path",
          "assertion",
          "revision",
          "command",
          "result"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{40}$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "question"
        ],
        "properties": {
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "states": {
      "type": "object",
      "required": [
        "readiness",
        "implementation",
        "verification"
      ],
      "properties": {
        "readiness": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "blocked"
          ]
        },
        "implementation": {
          "type": "string",
          "enum": [
            "missing",
            "partial",
            "implemented",
            "not_applicable"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "not_run",
            "failed",
            "partial",
            "passed"
          ]
        }
      },
      "additionalProperties": false
    },
    "status_owners": {
      "type": "object",
      "required": [
        "readiness",
        "implementation",
        "verification"
      ],
      "properties": {
        "readiness": {
          "type": "integer",
          "minimum": 1
        },
        "implementation": {
          "type": "integer",
          "minimum": 1
        },
        "verification": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
